# EmailJS browser delivery configuration.
# The EmailJS template recipient must be set to ijazahmedca@gmail.com.
# Configure the template to use: {{email_subject}} as its subject and
# {{email_body}} as its body. Set Reply-To to {{client_email}}.
# Public EmailJS identifiers are expected here; never add a private access token.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
