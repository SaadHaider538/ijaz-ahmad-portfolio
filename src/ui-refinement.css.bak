/* UI refinement: personal profile and navigation only. */
.hero .personal-hero-visual { min-width: 0; }
.hero .personal-hero-card { width: min(100%, 385px); margin: 0 0 0 auto; padding: 12px; border: 1px solid rgba(212,175,55,.55); background: rgba(255,255,255,.04); box-shadow: 16px 16px 0 rgba(4,12,29,.35); }
.hero .personal-hero-photo { height: clamp(235px, 38svh, 340px); background: #fff; overflow: hidden; }
.hero .personal-hero-photo img { display: block; width: 100%; height: 100%; object-fit: contain; object-position: center; }
.hero .personal-hero-card figcaption { padding: 12px 8px 5px; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 3px; }
.hero .personal-hero-card figcaption strong { color: #fff; font: 700 1.3rem/1.25 var(--serif); }
.hero .personal-hero-card figcaption span { color: var(--gold); font-size: .79rem; }
.hero .personal-profile-link { display: inline-flex; gap: 7px; align-items: center; margin-top: 6px; padding: 8px 4px; color: #e8edf6; font-size: .75rem; font-weight: 600; }
.hero .personal-profile-link:hover { color: var(--gold); }
.personal-profile-page .personal-profile-heading { max-width: 760px; margin-bottom: 32px; }
.personal-profile-page .personal-profile-heading h1 { color: var(--navy); font: 700 clamp(2.25rem, 5vw, 3.4rem)/1.15 var(--serif); margin: 0; }
.personal-profile-page .personal-profile-heading > p:last-child { color: var(--muted); margin: 16px 0 0; }
.personal-profile-page .personal-profile-layout { display: grid; grid-template-columns: minmax(0, 300px) minmax(0, 1fr); gap: clamp(24px, 5vw, 64px); align-items: start; padding: clamp(20px, 4vw, 40px); border: 1px solid var(--line); background: var(--light); }
.personal-profile-page .personal-profile-portrait { margin: 0; background: #fff; padding: 12px; border: 1px solid var(--line); }
.personal-profile-page .personal-profile-portrait img { display: block; width: 100%; height: auto; max-height: 350px; object-fit: contain; }
.personal-profile-page .personal-profile-portrait figcaption { text-align: center; font-weight: 700; color: var(--navy); padding: 12px 4px 4px; }
.personal-profile-page .personal-profile-copy h2 { font: 700 clamp(1.7rem, 3vw, 2.4rem)/1.2 var(--serif); color: var(--navy); margin: 0; }
.personal-profile-page .personal-profile-role { color: #806300; font-weight: 600; margin: 6px 0 20px; }
.personal-profile-page .personal-profile-copy > p:not(.panel-label):not(.personal-profile-role) { color: var(--muted); }
.personal-profile-page .personal-profile-copy h3 { font: 700 1.15rem/1.4 var(--serif); color: var(--navy); margin: 24px 0 10px; }
.personal-profile-page .personal-focus-list { list-style: none; padding: 0; margin: 0 0 24px; display: grid; gap: 8px; }
.personal-profile-page .personal-focus-list a { display: flex; align-items: center; gap: 9px; color: var(--navy); font-size: .88rem; font-weight: 600; padding: 7px 0; }
.personal-profile-page .personal-focus-list svg { flex: none; color: #806300; }
.personal-profile-page .personal-focus-list a:hover { text-decoration: underline; }
.navbar .nav-links a.button--gold, .navbar .nav-links a.button--gold:hover, .navbar .nav-links a.button--gold.active { color: var(--navy); }
/* The longer Profile label needs earlier menu collapse on medium screens. */
@media (min-width: 821px) and (max-width: 1100px) {
  .navbar .menu-toggle { display: block; cursor: pointer; }
  .navbar .nav-links { position: absolute; top: calc(100% + 8px); left: 18px; right: 18px; display: flex; flex-direction: column; align-items: stretch; gap: 0; padding: 15px; background: #0e1c34; border: 1px solid rgba(255,255,255,.12); box-shadow: 0 20px 40px rgba(0,0,0,.3); opacity: 0; visibility: hidden; transform: translateY(-10px); transition: opacity .2s, transform .2s, visibility .2s; max-height: calc(100dvh - var(--navbar-height) - 24px); overflow-y: auto; }
  .navbar .nav-links.is-open { opacity: 1; visibility: visible; transform: none; }
  .navbar .nav-links > a:not(.button) { padding: 13px; }
  .navbar .nav-links > a:after { display: none; }
  .navbar .nav-cta { display: flex; margin: 9px 0 0; }
}
@media (max-width: 820px) {
  .hero .personal-hero-card { width: min(330px, 88vw); margin-inline: auto; }
  .hero .personal-hero-photo { height: clamp(235px, 64vw, 300px); }
  .personal-profile-page .personal-profile-layout { grid-template-columns: 1fr; }
  .personal-profile-page .personal-profile-portrait { width: min(100%, 280px); margin-inline: auto; }
}
@media (max-width: 520px) {
  .hero .personal-hero-card { box-shadow: 9px 9px 0 rgba(4,12,29,.35); }
  .personal-profile-page .personal-profile-copy .button { width: 100%; }
}
